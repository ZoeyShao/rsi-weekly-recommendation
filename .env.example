# OMA console and API use the same origin in the current deployment.
OMA_BASE_URL=https://agentry.welltop.tech/api
OMA_API_KEY=replace-with-the-key-created-in-oma
OMA_AGENT_ID=replace-with-rsi-weekly-analyst-agent-id

PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
# Production: https://opengrove.io/rsi-weekly-recommendation
# The pathname becomes the route prefix; the reverse proxy must preserve it.

# This demo deliberately serializes OMA work to protect the arXiv API.
MAX_QUEUED_JOBS=20
REPORT_TIMEOUT_MS=900000
POLL_INTERVAL_MS=3000
REQUESTS_PER_IP_PER_HOUR=5
JOB_DATA_FILE=./data/jobs.json
ANALYTICS_DATA_DIRECTORY=./data

# Set both values to enable the private developer analytics dashboard at /admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
